#include <Geode/Geode.hpp>
#include <Geode/modify/MenuLayer.hpp>
#include <Geode/modify/PlayLayer.hpp>

using namespace geode::prelude;

static void applyFps() {
    double fps = 60.0;
    if (Mod::get()->getSettingValue<bool>("enabled")) {
        fps = static_cast<double>(Mod::get()->getSettingValue<int64_t>("fps"));
    }
    if (fps < 1.0) fps = 60.0;
    if (auto dir = CCDirector::get()) {
        dir->setAnimationInterval(1.0 / fps);
    }
}

$on_mod(Loaded) {
    listenForSettingChanges<bool>("enabled", [](bool) { applyFps(); });
    listenForSettingChanges<int64_t>("fps", [](int64_t) { applyFps(); });
}

// GD puede reiniciar el intervalo al cambiar de escena: lo reaplicamos.
class $modify(StableMenu, MenuLayer) {
    bool init() {
        if (!MenuLayer::init()) return false;
        applyFps();
        return true;
    }
};

class $modify(StablePlay, PlayLayer) {
    bool init(GJGameLevel* level, bool useReplay, bool dontCreateObjects) {
        if (!PlayLayer::init(level, useReplay, dontCreateObjects)) return false;
        applyFps();
        return true;
    }
};
